# Gate API credentials — create a READ-ONLY key and bind it to your IP.
# Never enable trade or withdraw permissions for this dashboard.
GATE_API_KEY=
GATE_API_SECRET=

# API host. Use api.gateio.ws unless you need a regional endpoint.
GATE_API_HOST=https://api.gateio.ws

# Which account views to enable, in tab order.
# Options: spot, futures_usdt, futures_btc, unified
GATE_ACCOUNTS=spot,futures_usdt

# Gate usually requires an explicit currency_pair on the spot trade history
# endpoint. List the pairs you actually trade as a fallback for when the
# unfiltered query is rejected.
GATE_SPOT_PAIRS=

# Day boundary for all "daily" figures. This decides every number on the daily
# page — set it to whatever Gate's web UI shows you, or your own local timezone
# if you'd rather read it that way.
DASHBOARD_TZ=Asia/Shanghai

# Quote currency that PnL is reported in.
DASHBOARD_QUOTE=USDT

# Set to 1 to serve fabricated account snapshots so the page can be previewed
# without credentials. The UI shows a standing red warning while this is on.
# Never leave it set once real keys are configured.
DASHBOARD_DEMO=

# Local history database.
DB_PATH=./gate_dashboard.sqlite3
